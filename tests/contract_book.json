{
 "book": "Contract book - the test server reproduces the behaviours seen in the two live sessions",
 "cases": [
  {
   "name": "(setup) reset server state",
   "request": {
    "method": "POST",
    "path": "/_test/reset",
    "body": {}
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "path": "ok",
      "op": "eq",
      "value": true
     }
    ]
   }
  },
  {
   "name": "M-01 a fresh server holds no records",
   "request": {
    "method": "GET",
    "path": "/_test/stats"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "path": "records",
      "op": "eq",
      "value": 0
     },
     {
      "path": "requests",
      "op": "eq",
      "value": 0
     }
    ]
   }
  },
  {
   "name": "M-02 a top-level mandate is not read: scope UNDECIDED",
   "request": {
    "method": "POST",
    "path": "/api/exchange/manifest",
    "body": {
     "agent_name": "contract-agent",
     "manifest_text": "identity \u2014 principal: Test Co, pm@example.test\nwants \u2014 a project manager for 3 months\noffers \u2014 nothing\ninterface \u2014 I poll every 6 hours\ndelivery_contract \u2014 data\nboundary \u2014 nothing",
     "mandate": {
      "intents": [
       {
        "direction": "buy",
        "service_type": "consultant_search",
        "scope": {
         "capability": "project management"
        }
       }
      ]
     }
    }
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "path": "scope.bucket",
      "op": "eq",
      "value": "UNDECIDED"
     }
    ]
   }
  },
  {
   "name": "M-03 a nested mandate is read: scope SERVED",
   "request": {
    "method": "POST",
    "path": "/api/exchange/manifest",
    "body": {
     "agent_name": "contract-agent",
     "manifest_text": "identity \u2014 principal: Test Co, pm@example.test\nwants \u2014 a project manager for 3 months\noffers \u2014 nothing\ninterface \u2014 I poll every 6 hours\ndelivery_contract \u2014 data\nboundary \u2014 nothing",
     "manifest": {
      "mandate": {
       "intents": [
        {
         "direction": "buy",
         "service_type": "consultant_search",
         "scope": {
          "capability": "project management"
         }
        }
       ]
      }
     }
    }
   },
   "capture": {
    "msgid": "msgid"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "path": "scope.bucket",
      "op": "eq",
      "value": "SERVED"
     },
     {
      "path": "msgid",
      "op": "exists"
     }
    ]
   }
  },
  {
   "name": "M-03b the thread agrees with the receipt (default server)",
   "request": {
    "method": "GET",
    "path": "/api/exchange/answer/${msgid}"
   },
   "expect": {
    "status": 200,
    "json": [
     {
      "path": "scope.bucket",
      "op": "eq",
      "value": "SERVED"
     },
     {
      "path": "state.access.tier",
      "op": "eq",
      "value": 1
     },
     {
      "path": "state.access.handshake",
      "op": "eq",
      "value": "accepted"
     },
     {
      "path": "use_this_instead",
      "op": "absent"
     }
    ]
   }
  },
  {
   "name": "(setup) reset server state",
   "request": {
    "method": "POST",
    "path": "/_test/reset",
    "body": {}
